# Local image names for the Compose integration example.
# Build these images from your own worker deployment before starting Compose.
MAP_WORKER_IMAGE=urban-map-map-worker:local
DEPTHMAPXCLI_IMAGE=urban-map-depthmapxcli:local

# The CLI must be installed inside the Map Worker image at this path.
DEPTHMAPX_CLI_PATH=/usr/local/bin/depthmapXcli

# Local development port. Put an authenticated reverse proxy in front of a public deployment.
MAP_WORKER_PORT=8000
